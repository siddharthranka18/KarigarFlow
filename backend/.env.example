PROJECT_NAME=KarigarFlow
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://postgres@localhost:5433/karigarflow_db
# Configure SECRET_KEY locally for persistent sessions; otherwise development generates one.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Workshop specific defaults
DEFAULT_PURITY_PURCHASE=99.90
DEFAULT_PURITY_ORNAMENT_22K=91.60
DEFAULT_PURITY_ORNAMENT_18K=75.00
MAX_ALLOWED_WASTAGE_PERCENT=2.50
LOSS_ALERT_THRESHOLD_GRAMS=0.100

